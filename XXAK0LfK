/* ---------- LLM（8s 超时回落） ---------- */
function getLLM() { try { return JSON.parse(localStorage.getItem("yijian_llm") || "null"); } catch (e) { return null; } }
function generateLLMLooks(env, cb) {
  var cfg = getLLM();
  if (!cfg || !cfg.baseUrl || !cfg.apiKey) { cb(null); return; }
  var ctrl = new AbortController();
  var timer = setTimeout(function () { ctrl.abort(); }, 8000);
  var prompt = "你是穿搭助手。衣橱JSON：" + JSON.stringify(WARDROBE.map(function (w) { return { name: w.name, cat: w.cat, tags: w.tags, seasons: w.seasons }; })) +
    "。今日" + env.feelsLike + "℃（" + env.tp.label + "），场合：" + env.goalName + (env.hot ? "，风格：" + env.hot : "") +
    "。生成3套搭配，每套各选 top/bottom/shoes/accessory。返回JSON：{looks:[{styleName,slots:[{cat,name,why}x4]}x3]}，why一句话。只要JSON。";
  fetch(cfg.baseUrl.replace(/\/$/, "") + "/chat/completions", {
    method: "POST", signal: ctrl.signal,
    headers: { "Content-Type": "application/json", "Authorization": "Bearer " + cfg.apiKey },
    body: JSON.stringify({ model: cfg.model || "glm-4-flash", messages: [{ role: "user", content: prompt }], temperature: 0.7 })
  }).then(function (r) { return r.json(); }).then(function (j) {
    clearTimeout(timer);
    var txt = (j.choices && j.choices[0] && j.choices[0].message && j.choices[0].message.content) || "";
    var m = txt.match(/\{[\s\S]*\}/);
    if (!m) { cb(null); return; }
    var out = JSON.parse(m[0]);
    var looks = (out.looks || []).map(function (lo) {
      var picked = [];
      CAT_SLOTS.forEach(function (cs) {
        var sl = (lo.slots || []).filter(function (x) { return x.cat === cs[0]; })[0];
        var w = WARDROBE.filter(function (x) { return x.name === (sl && sl.name); })[0] || poolOf(cs[0])[0];
        if (w) picked.push({ item: w, why: (sl && sl.why) || "LLM 推荐", lucky: false, rawScore: 50 });
      });
      return { picked: picked, styleName: lo.styleName || "AI 生成", env: env, lucky: false };
    }).filter(function (l) { return l.picked.length === 4; });
    cb(looks.length ? looks : null);
  }).catch(function () { clearTimeout(timer); cb(null); });
}

