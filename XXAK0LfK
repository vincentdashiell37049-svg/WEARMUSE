function chatParse(text) {
  var t = text.trim();
  var r = {};
  if (/降温|变冷|冷/.test(t)) { r.temp = true; }
  if (/约会|见面|相亲/.test(t)) { r.goal = "date"; r.goalName = "周末约会"; }
  else if (/面试|实习|笔试|商务/.test(t)) { r.goal = "formal"; r.goalName = "商务出行"; }
  else if (/长辈|家长|爸妈|父母/.test(t)) { r.goal = "meetparents"; r.goalName = "见长辈"; }
  else if (/旅行|旅游|出差|爬山/.test(t)) { r.goal = "travel"; r.goalName = "旅行"; }
  else if (/通勤|上班|早八/.test(t)) { r.goal = "commute"; r.goalName = "日常通勤"; }
  if (/美拉德/.test(t)) r.hot = "美拉德";
  else if (/智性|高级|气场/.test(t)) r.hot = "智性";
  else if (/森女|松弛|慵懒/.test(t)) r.hot = "森女";
  else if (/温柔|奶系|甜/.test(t)) r.hot = "温柔";
  if (/惊艳|心动|好看/.test(t)) r.why = "想被夸的心情我懂，这套的回头率按 120% 算。";
  return r;
}
