function phCompress(dataUrl, cb) {
  var im = new Image();
  im.onload = function () {
    var max = 480, sc = Math.min(1, max / Math.max(im.width, im.height));
    var cv = document.createElement("canvas");
    cv.width = Math.round(im.width * sc); cv.height = Math.round(im.height * sc);
    try { cv.getContext("2d").drawImage(im, 0, 0, cv.width, cv.height); cb(cv.toDataURL("image/jpeg", 0.72)); } catch (e) { cb(dataUrl); }
  };
  im.onerror = function () { cb(dataUrl); };
  im.src = dataUrl;
}
function phEnsureRecord() {
  var rec = OOTD_LOG[PH.date];
  if (!rec) {
    var lk = genLooks(curEnv())[0];
    rec = OOTD_LOG[PH.date] = { styleName: lk.styleName, picked: lk.picked.map(function (p) { return p.item; }), photo: "", env: lk.env, published: false };
    if (CAL.days.indexOf(PH.date) < 0) { CAL.days.push(PH.date); lsSet("yijian_cal", CAL); }
