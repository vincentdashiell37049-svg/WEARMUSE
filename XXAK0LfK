function isDirty(w) { return DIRTY.indexOf(w.id) >= 0; }
function isStored(w) { return STORED.indexOf(w.id) >= 0; }
function markDirty(picked) {
  picked.forEach(function (p) {
    var w = p.item;
    if (w) {
      if (DIRTY.indexOf(w.id) < 0) DIRTY.push(w.id);
      w.lastWorn = 0; w.wear = (w.wear || 0) + 1;
    }
  });
  lsSet("yijian_dirty", DIRTY);
}
function markClean(id) {
  var i = DIRTY.indexOf(id);
  if (i >= 0) { DIRTY.splice(i, 1); lsSet("yijian_dirty", DIRTY); }
}
function washAll() { DIRTY = []; lsSet("yijian_dirty", []); }
function toggleStored(id) {
  var i = STORED.indexOf(id);
  if (i >= 0) STORED.splice(i, 1); else { STORED.push(id); markClean(id); }
  lsSet("yijian_stored", STORED);
