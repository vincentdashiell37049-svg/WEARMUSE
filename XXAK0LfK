function drawCard(cardEl) {
  if (tarotDrawn.length >= 3) return;
  if (cardEl.classList.contains("fly")) return; /* 防双击重复抽 */
  var pool = TAROT_DECK.filter(function (d) { return tarotDrawn.indexOf(d) < 0; });
  var pick = pool[Math.floor(Math.random() * pool.length)];
  tarotDrawn.push(pick);
  cardEl.classList.add("fly");
  setTimeout(function () { cardEl.style.display = "none"; }, 320);
  $("deck-tip").textContent = "已抽 " + tarotDrawn.length + " / 3 张" + (tarotDrawn.length >= 3 ? " · 点击牌面翻开解读" : "");
