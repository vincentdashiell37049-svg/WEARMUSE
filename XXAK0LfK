    /* 真实走发布落库：标记今日记录已发布并同步各视图 */
    var rec = OOTD_LOG[todayStr()];
    if (!rec && S.looks) {
      var lk = S.looks[S.curLook];
      rec = OOTD_LOG[todayStr()] = { styleName: lk.styleName, picked: lk.picked.map(function (p) { return p.item; }), photo: "", env: lk.env, published: false };
      if (CAL.days.indexOf(todayStr()) < 0) { CAL.days.push(todayStr()); lsSet("yijian_cal", CAL); }
      markDirty(lk.picked);
    }
    if (rec && !rec.published) { rec.published = true; lsSet("yijian_ootd", OOTD_LOG); }
    renderOotdLog(); renderTodayLog(); renderCalendar(); renderMeStats();
    toast("已发布到小红书 · 日历里标记为已发布");
  });

  $("btn-sub").addEventListener("click", function () { renderFree(); $("ov-pay").classList.add("on"); });
  $("tg-llm").addEventListener("click", function () {
    var off = $("tg-llm").classList.toggle("off");
    if (!off && !getLLM()) { toast("请先填写接口配置"); }
    $("llm-config").style.display = off ? "none" : "block";
  });
  $("btn-savekey").addEventListener("click", function () {
    var cfg = { baseUrl: $("in-baseurl").value.trim(), apiKey: $("in-apikey").value.trim(), model: $("in-model").value.trim() };
    if (!cfg.baseUrl || !cfg.apiKey) { toast("Base URL 和 API Key 必填"); return; }
    lsSet("yijian_llm", cfg);
    toast("已保存 · 仅存本浏览器");
    renderLlmUI();
  });
  $("btn-wash").addEventListener("click", function () {
    washAll(); renderCalendar(); renderWardrobe(); renderMeStats();
    toast("已全部归队 · 推荐池恢复满员");
  });
  $("btn-match").addEventListener("click", function () { renderMatchPick(); if (!matchLock) openMatch(WARDROBE[0]); else openMatch(matchLock); });
  bindFaceUpload();
  bindEditProfile();
  bindPhotoFlow();
  /* 我的 · 资产宫格 */
  $("as-wardrobe").addEventListener("click", function () { switchTab("wardrobe"); });
  $("as-beauty").addEventListener("click", function () {
    if (!S.looks) { var looks = genLooks(curEnv()); S.looks = looks; }
    enterBeautyPage();
  });
  $("as-fav").addEventListener("click", function () { $("fav-looks").scrollIntoView({ behavior: "smooth", block: "center" }); });
  $("as-cal").addEventListener("click", function () { renderCalendar(); switchTab("cal"); });
  var bvis = $("btn-visual"); if (bvis) bvis.addEventListener("click", function () { goView("visual"); });
  /* 衣橱 · 单品管理：搜索 + 排序 */
  $("wr-search").addEventListener("input", function () { WF.q = this.value; renderWardrobe(); });
  $("wr-sort").addEventListener("click", function () { WF.sortDesc = !WF.sortDesc; renderWardrobe(); });
  /* AI 搭子 · 技能入口 */
  document.querySelectorAll("[data-vskill]").forEach(function (b) {
    b.addEventListener("click", function () { vchatSkillTrip(); });
  });
  /* 穿搭日历 · 月/周切换 + 月份导航 + 今天 */
  document.querySelectorAll("[data-calv]").forEach(function (b) {
    b.addEventListener("click", function () {
      CALV.mode = b.getAttribute("data-calv");
      document.querySelectorAll("[data-calv]").forEach(function (x) { x.classList.toggle("on", x === b); });
      renderCalendar();
    });
  });
  $("cal-prev").addEventListener("click", function () { CALV.offset--; renderCalendar(); });
  $("cal-next").addEventListener("click", function () { if (CALV.offset < 0) { CALV.offset++; renderCalendar(); } else { toast("已经是最新的月份啦"); } });
  $("cal-today-fab").addEventListener("click", function () {
    CALV.offset = 0; CALV.mode = "month";
    document.querySelectorAll("[data-calv]").forEach(function (x) { x.classList.toggle("on", x.getAttribute("data-calv") === "month"); });
    renderCalendar();
    $("view-cal").querySelector(".vbody").scrollTo({ top: 0, behavior: "smooth" });
  });
  $("vs-trigger").addEventListener("click", function () { $("vs-file").click(); });
  bindVisual();

  $("btn-subscribe").addEventListener("click", function () {
    if (freeLeft > 0 && !isPro) { freeLeft--; lsSet("yijian_free", freeLeft); }
    isPro = true; lsSet("yijian_pro", true);
    $("ov-pay").classList.remove("on");
    renderFree(); enterBeautyPage();
    toast("Pro 已解锁 · 妆容方案已生成");
  });

  /* 负反馈 */
  document.querySelectorAll("#dislike-chips .chip").forEach(function (c) {
    c.addEventListener("click", function () { c.classList.toggle("on"); });
  });
  $("btn-regen").addEventListener("click", function () {
    NEG_FB = [];
    document.querySelectorAll("#dislike-chips .chip.on").forEach(function (c) { NEG_FB.push(c.getAttribute("data-dl")); });
    $("ov-dislike").classList.remove("on");
    genAndShow();
    toast(NEG_FB.length ? "已记录「" + NEG_FB.join("、") + "」· 重新生成" : "已重新生成");
  });

  document.querySelectorAll("[data-close]").forEach(function (b) { b.addEventListener("click", function () { $(b.getAttribute("data-close")).classList.remove("on"); }); });
  document.querySelectorAll(".overlay").forEach(function (ov) { ov.addEventListener("click", function (e) { if (e.target === ov) ov.classList.remove("on"); }); });
  ["sl-in","sl-out","sl-price","sl-use"].forEach(function (id) { $(id).addEventListener("input", calcToken); });
}

/* ---------- 启动 ---------- */
function init() {
  $("s4-lucky").textContent = S.luckyFam;
  bind(); renderEvals(); calcToken(); renderWardrobe(); renderFree(); renderLlmUI(); renderCalendar(); renderShopScroll(); renderMeStats(); renderHeroScroll(); applyProfile();
  /* 强制从首页开始：外部重写可能把 on class 留在别的视图上 */
  backSubViews(); switchTab("home");
  loadWeather();
  armProactiveAI();
}
if (typeof document !== "undefined" && document.getElementById("app")) { init(); }
