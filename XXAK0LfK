var CALV = { mode: "month", offset: 0 };
function calMonthBase(offset) { var n = new Date(); return new Date(n.getFullYear(), n.getMonth() + offset, 1); }
function calCellHTML(y, m, d, today) {
  var s = y + "-" + pad2(m + 1) + "-" + pad2(d);
