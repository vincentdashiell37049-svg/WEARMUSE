function renderCalWall() {
  var base = calMonthBase(CALV.offset);
  var y = base.getFullYear(), m = base.getMonth();
  $("cal-month-title").textContent = y + "/" + pad2(m + 1);
  var today = todayStr();
  var h = ["日", "一", "二", "三", "四", "五", "六"].map(function (d) { return '<div class="cal-dow">' + d + "</div>"; }).join("");
  if (CALV.mode === "month") {
    var first = new Date(y, m, 1).getDay();
    var days = new Date(y, m + 1, 0).getDate();
    for (var b = 0; b < first; b++) h += '<div class="cal-cell blank"></div>';
    for (var d = 1; d <= days; d++) h += calCellHTML(y, m, d, today);
  } else {
    /* 周视图：今天所在的一周，7 格大卡 */
    var now = new Date();
    now.setDate(now.getDate() - now.getDay());
    for (var i = 0; i < 7; i++) {
      var dd = new Date(now);
      dd.setDate(now.getDate() + i);
      h += calCellHTML(dd.getFullYear(), dd.getMonth(), dd.getDate(), today);
    }
  }
  $("cal-grid").innerHTML = h;
  $("cal-grid").querySelectorAll("[data-caladd]").forEach(function (b) {
